{
  "name": "apthex-internal-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Apthex internal operations portal — private, login-only internal application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-local": "tsx scripts/local-db.ts --reset && tsx scripts/seed.ts",
    "otp": "tsx scripts/otp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@node-rs/argon2": "2.0.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "lucide-react": "0.468.0",
    "mongodb": "^7.7.0",
    "next": "15.5.28",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=20.19"
  }
}
