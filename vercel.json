{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/c", "destination": "https://apt-root.apthex.com/api/c" },
    { "source": "/_next/:path*", "destination": "https://apthex-complaint.vercel.app/_next/:path*" },
    { "source": "/api/:path*", "destination": "https://apthex-complaint-api.vercel.app/api/:path*" },
    { "source": "/complaint", "destination": "https://apthex-complaint.vercel.app/complaint" },
    { "source": "/complaint/:path*", "destination": "https://apthex-complaint.vercel.app/complaint/:path*" },
    { "source": "/complaint-review-console", "destination": "https://apthex-complaint.vercel.app/complaint-review-console" },
    { "source": "/complaint-review-console/:path*", "destination": "https://apthex-complaint.vercel.app/complaint-review-console/:path*" }
  ]
}
