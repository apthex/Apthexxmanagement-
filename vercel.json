{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/_next/:path*", "destination": "https://apthex-complaint.vercel.app/_next/:path*" },
    { "source": "/api/:path*", "destination": "https://apthex-complaint.vercel.app/api/:path*" },
    { "source": "/complaint", "destination": "https://apthex-complaint.vercel.app/complaint" },
    { "source": "/complaint/:path*", "destination": "https://apthex-complaint.vercel.app/complaint/:path*" },
    { "source": "/complaint-review-console", "destination": "https://apthex-complaint.vercel.app/complaint-review-console" },
    { "source": "/complaint-review-console/:path*", "destination": "https://apthex-complaint.vercel.app/complaint-review-console/:path*" },
    { "source": "/admin", "destination": "https://apthex-complaint.vercel.app/complaint-review-console" },
    { "source": "/admin/:path*", "destination": "https://apthex-complaint.vercel.app/complaint-review-console/:path*" },
    { "source": "/portal", "destination": "https://apthex-complaint.vercel.app/complaint-review-console" },
    { "source": "/portal/:path*", "destination": "https://apthex-complaint.vercel.app/desk/:path*" },
    { "source": "/login", "destination": "https://apthex-complaint.vercel.app/complaint-review-console" },
    { "source": "/dashboard", "destination": "https://apthex-complaint.vercel.app/desk" },
    { "source": "/dashboard/:path*", "destination": "https://apthex-complaint.vercel.app/desk/:path*" },
    { "source": "/help", "destination": "https://apthex-complaint.vercel.app/complaint" },
    { "source": "/help/:path*", "destination": "https://apthex-complaint.vercel.app/:path*" },
    { "source": "/desk", "destination": "https://apthex-complaint.vercel.app/desk" },
    { "source": "/category", "destination": "https://apthex-complaint.vercel.app/category" },
    { "source": "/details", "destination": "https://apthex-complaint.vercel.app/details" },
    { "source": "/thanks", "destination": "https://apthex-complaint.vercel.app/thanks" },
    { "source": "/status", "destination": "https://apthex-complaint.vercel.app/status" },
    { "source": "/status/:path*", "destination": "https://apthex-complaint.vercel.app/status/:path*" },
    { "source": "/desk/:path*", "destination": "https://apthex-complaint.vercel.app/desk/:path*" }
  ]
}
