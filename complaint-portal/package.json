{
  "name": "apthex-complaint-portal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client-next"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client-next run dev",
    "build": "npm --workspace client-next run build && npm --workspace server run build",
    "start:server": "npm --workspace server run start",
    "start:client": "npm --workspace client-next run start",
    "test": "npm --workspace server run test",
    "test:smoke": "npm --workspace server run test:smoke",
    "seed": "npm --workspace server run seed"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "bcrypt@6.0.0": true,
    "mongodb-memory-server@10.4.3": true
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
