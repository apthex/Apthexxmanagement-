# ---------------------------------------------------------------------------
# APTHEX Complaint Portal — environment template
# Copy this file to server/.env. Never commit the real file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops. Use 0 if the API is directly exposed.
# An incorrect value lets clients spoof their IP for rate limiting.
TRUST_PROXY=1
LOG_LEVEL=info

# MongoDB. Use your Atlas connection string in server/.env, never in git.
# Without MONGODB_URI the development server starts an in-memory database
# (data is lost on restart), which is useful for a quick local demo only.
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=apthex_complaint_portal

# Public frontend and API origins. Next.js runs on port 3000 in development.
APP_BASE_URL=http://localhost:3000
CASE_DESK_URL=http://localhost:3000/desk
# Optional comma-separated extra origins allowed to call the API.
CORS_ORIGINS=
# Reject state-changing requests without an Origin/Referer.
# Set true in production (the production deployment uses a same-origin proxy).
REQUIRE_ORIGIN=false

# Staff sessions and TOTP secret encryption.
# Generate each with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
TOTP_ENCRYPTION_KEY=replace-with-a-different-random-32-plus-character-key
SESSION_TTL_HOURS=8

# Public portal behaviour
RETENTION_DAYS=30
ESCALATION_DAYS=7
SMALL_NUMBER_THRESHOLD=5
DUPLICATE_WINDOW_MINUTES=10
CRON_TIMEZONE=Asia/Kolkata

# Email delivery (Resend). Leave blank in development.
# Selected production sender subdomain: mail.apthex.com (verify it in Resend
# and add the DNS records first). Resend cannot send from a @gmail.com address.
RESEND_API_KEY=
EMAIL_FROM=APTHEX Complaint Portal <no-reply@mail.apthex.com>
APTHEX_CASE_MAILBOX=
URGENT_ALERT_RECIPIENTS=
EMAIL_DEV_LOG=true
EMAIL_MAX_ATTEMPTS=5
EMAIL_OUTBOX_TTL_DAYS=30

# Cloudflare Turnstile CAPTCHA. Leave blank in development and keep the
# bypass true only on your local machine. Production refuses to start with
# CAPTCHA_DEV_BYPASS=true.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CAPTCHA_DEV_BYPASS=true

# Private evidence storage. Local storage is for development only.
# Production requires Vercel Blob private storage. Create a Vercel Blob store,
# generate a read/write token in the Vercel dashboard, and set it below. The
# token is server-only and must never be committed or exposed to the browser.
# Example: BLOB_READ_WRITE_TOKEN=vercel_blob_rw_abc123...
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
BLOB_READ_WRITE_TOKEN=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Upload limits
MAX_IMAGE_BYTES=2097152
MAX_VOICE_BYTES=10485760
MAX_VOICE_SECONDS=60
MAX_IMAGES=5
MAX_TOTAL_UPLOAD_BYTES=26214400

# Abuse-rate limits (per rolling window)
RATE_LIMIT_SUBMIT_PER_IP_HOUR=5
RATE_LIMIT_ANON_PER_IP_HOUR=3
RATE_LIMIT_SUBMIT_PER_DEVICE_HOUR=5
RATE_LIMIT_ANON_PER_DEVICE_HOUR=2
RATE_LIMIT_STATUS_PER_IP_MINUTE=10
RATE_LIMIT_FOLLOWUP_PER_HOUR=3
RATE_LIMIT_LOGIN_PER_15_MIN=5
RATE_LIMIT_INSTITUTE_PER_MINUTE=30

# Development convenience. AUTO_SEED creates demo institutes and an owner.
# Never enable AUTO_SEED in production.
AUTO_SEED=true
SEED_OWNER_EMAIL=owner@apthex.local
SEED_OWNER_PASSWORD=ChangeMe!123

# Next.js frontend proxy target (client-next/next.config.mjs)
# API_PROXY_TARGET=http://localhost:4000
