# APTHEX Complaint Portal - server environment variables
# Copy this file to .env and fill in the values. Never commit .env with real secrets.
# BLOB_READ_WRITE_TOKEN is server-only and must NEVER be exposed to the frontend
# or committed to version control.

NODE_ENV=development
PORT=4000
TRUST_PROXY=1

MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.ye8dpbm.mongodb.net/Apethexhelpportal?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=Apethexhelpportal

APP_BASE_URL=http://localhost:3000/help
CASE_DESK_URL=http://localhost:3000/help/desk
CORS_ORIGINS=http://localhost:3000

# Production values (final URL layout — Nov 2026). Remove the localhost values
# above and uncomment this block when deploying. Note the browser origin is the
# bare site origin: the Origin header carries no path, so CORS_ORIGINS lists it
# without `/help`.
# APP_BASE_URL=https://apthex.com/help
# CASE_DESK_URL=https://apthex.com/help/desk
# CORS_ORIGINS=https://apthex.com

SESSION_SECRET=<32+ random characters>
SESSION_TTL_HOURS=8
TOTP_ENCRYPTION_KEY=<32+ random bytes>
REQUIRE_ORIGIN=false

RETENTION_DAYS=30
ESCALATION_DAYS=7
SMALL_NUMBER_THRESHOLD=5
DUPLICATE_WINDOW_MINUTES=10
CRON_TIMEZONE=Asia/Kolkata

RESEND_API_KEY=<Resend API key>
EMAIL_FROM=APTHEX Complaint Portal <apthexx@gmail.com>
APTHEX_CASE_MAILBOX=case@apthex.local
URGENT_ALERT_RECIPIENTS=urgent@apthex.local
EMAIL_DEV_LOG=true
EMAIL_MAX_ATTEMPTS=5
EMAIL_OUTBOX_TTL_DAYS=30

CLOUDFLARE_TURNSTILE_SITE_KEY=<Turnstile site key>
CLOUDFLARE_TURNSTILE_SECRET_KEY=<Turnstile secret key>
CAPTCHA_DEV_BYPASS=true

# Storage driver: "local" (development only) or "vercel-blob" (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
STORAGE_SIGNING_SECRET=<optional signing secret for local download URLs>
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Server-side read/write token for the private Vercel Blob store
# (`apthex-complaint-evidence`). Required when STORAGE_DRIVER=vercel-blob.
# Never exposed to the client. Never commit the real value.
BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>

MAX_IMAGE_BYTES=2097152
# Vercel Blob `put()` (server upload) is capped at 4.5 MB.
MAX_VOICE_BYTES=4718592
MAX_VOICE_SECONDS=60
MAX_IMAGES=5
MAX_TOTAL_UPLOAD_BYTES=26214400

RATE_LIMIT_SUBMIT_PER_IP_HOUR=5
RATE_LIMIT_ANON_PER_IP_HOUR=3
RATE_LIMIT_SUBMIT_PER_DEVICE_HOUR=5
RATE_LIMIT_ANON_PER_DEVICE_HOUR=2
RATE_LIMIT_STATUS_PER_IP_MINUTE=10
RATE_LIMIT_FOLLOWUP_PER_HOUR=3
RATE_LIMIT_LOGIN_PER_15_MIN=5
RATE_LIMIT_INSTITUTE_PER_MINUTE=30

AUTO_SEED=true
SEED_OWNER_EMAIL=owner@apthex.local
SEED_OWNER_PASSWORD=ChangeMe!123
LOG_LEVEL=info
