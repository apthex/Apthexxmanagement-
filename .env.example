# ---------------------------------------------------------------------------
# Apthex Internal Portal — environment template
# Copy to .env.local for development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Local development uses PGlite. Production must use PostgreSQL.
DATABASE_URL=pglite://./.local-db
# Owner/migration role only. Used by `npm run db:migrate`.
DATABASE_URL_MIGRATE=pglite://./.local-db
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Application URL, no trailing slash.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts TOTP secrets. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 32 random bytes, base64. Peppers setup tokens and recovery-code hashes.
TOKEN_PEPPER=replace-with-32-byte-base64-key

# TOTP. Set TOTP_REQUIRED=false only with formal owner approval.
TOTP_REQUIRED=true
TOTP_ISSUER=Apthex Internal

# Cloudflare Access. Enforce in production. Locally, leave gate disabled.
ACCESS_GATE_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Resend. In development, email bodies are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Apthex Internal <no-reply@apthex.com>"
OWNER_ALERT_EMAILS=

# LiveWeb / Matomo. Required for visitor-level data. Leave blank to show "unavailable".
MATOMO_URL=
MATOMO_TOKEN=
MATOMO_SITE_ID=

# Vercel cron digest authentication.
CRON_SECRET=

# Non-production convenience: show invite links once to the owner.
DEV_SHOW_SETUP_LINKS=true

# Seed data only. Fake accounts, local/staging only.
SEED_OWNER_EMAIL=devendra@apthex.test
SEED_OWNER_PASSWORD=Apthex-local-owner-2026
SEED_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DP
